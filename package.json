{
  "name": "ai-mystery-room",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm --workspace server run dev",
    "dev:client": "npm --workspace client run dev",
    "build": "npm --workspace shared run build && npm --workspace server run build && npm --workspace client run build",
    "typecheck": "npm run build",
    "start": "npm --workspace server run start",
    "test": "npm --workspace server run test",
    "e2e": "playwright test",
    "lint": "eslint client server shared e2e playwright.config.ts eslint.config.js",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,css,html}\"",
    "check": "npm run lint && npm run typecheck && npm run test && npm run e2e"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "concurrently": "^9.1.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "prettier": "^3.9.10",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.72.1"
  }
}
